# Copy to .env (developer overrides, never written by Kavot) or edit the user file
# Kavot writes next to settings.json: %APPDATA%\Kavot\.env, ~/Library/Application
# Support/Kavot/.env or ~/.config/Kavot/.env. Real environment variables win over
# both files. Values stay inside Kavot: agent CLIs and scripts never receive them.

# Paths
# KAVOT_STORAGE_PATH='/path/to/workspace'
# KAVOT_CONFIG_PATH='/path/to/config'      # repository .env or environment only

# Services
# KAVOT_CLOUD_URL='https://kavot.cloud'
# KAVOT_DISABLED_PLUGINS='research,planning'
# KAVOT_WEBVIEW_DEBUG=1

# Credentials (set from Settings, or here)
# KAVOT_ZOTERO_API_KEY=''
# KAVOT_ZOTERO_USER_ID=''
# OPENALEX_API_KEY=''
# SEMANTIC_SCHOLAR_API_KEY=''
# OPENCITATIONS_ACCESS_TOKEN=''
# KAVOT_CROSSREF_API_KEY=''
# KAVOT_EUROPE_PMC_API_KEY=''
# KAVOT_ARXIV_API_KEY=''
