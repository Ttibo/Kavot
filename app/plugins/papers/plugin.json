{
  "id": "papers",
  "name": "Papers",
  "version": "1.0.0",
  "requires_core": ">=2.0",
  "description": "Article library, PDF reading, citation graph, discovery, Zotero and article watches.",
  "removable": false,
  "state_collections": ["papers", "paper_folders", "paper_references", "citations", "article_watches", "discovery_explorations"],
  "collections": [
    {
      "id": "articles", "name": "Articles", "record_kind": "paper", "position": 10,
      "source": "library/", "views": ["table", "folders"], "tools": [],
      "storage": {"driver": "domain", "domain": "library"},
      "state_key": "papers", "title_field": "title",
      "search_fields": ["title", "abstract", "authors", "publication", "published_at", "doi", "tags"],
      "agent_actions": {"create": "paper_import", "update": "paper_update", "organize": "paper_organize", "delete": "paper_delete"}
    }
  ],
  "link_types": [
    {"id": "cites", "from": "articles", "to": "articles", "label": "cites"},
    {"id": "reading_note_of", "from": "notes", "to": "articles", "label": "reading note of", "field": "paper_id"}
  ],
  "connectors": [
    {"id": "zotero", "kind": "code", "label": "Zotero", "permissions": ["network:api.zotero.org"]},
    {"id": "openalex", "kind": "code", "label": "OpenAlex", "permissions": ["network:api.openalex.org"]},
    {"id": "crossref", "kind": "code", "label": "Crossref", "permissions": ["network:api.crossref.org"]},
    {"id": "semantic_scholar", "kind": "code", "label": "Semantic Scholar", "permissions": ["network:api.semanticscholar.org"]},
    {"id": "opencitations", "kind": "code", "label": "OpenCitations", "permissions": ["network:opencitations.net"]},
    {"id": "europe_pmc", "kind": "code", "label": "Europe PMC", "permissions": ["network:www.ebi.ac.uk"]},
    {"id": "arxiv", "kind": "code", "label": "arXiv", "permissions": ["network:export.arxiv.org"]}
  ]
}
